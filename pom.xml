<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fincore</groupId>
    <artifactId>fincore-banking</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- 1. Spring Boot Parent: Manages all versions -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.2</version>
        <relativePath/> 
    </parent>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <pitest.version>1.16.1</pitest.version>
    </properties>

    <dependencies>
        <!-- 2. Web Support (Tomcat, REST, Controllers) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 3. HTML View Engine (Thymeleaf) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 4. Testing (Includes JUnit 5, Mockito, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Build Plugin (Makes the app executable) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- PITest Mutation Testing Plugin -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Target ONLY logic classes (High Mutation Score Strategy) -->
                    <targetClasses>
                        <param>com.fincore.model.*</param>
                        <param>com.fincore.service.*</param>
                        <param>com.fincore.util.*</param>
                        <param>com.fincore.repository.*</param>
                    </targetClasses>
                    
                    <targetTests>
                        <param>com.fincore.*</param>
                    </targetTests>

                    <!-- Exclude Web Controllers and Main App from Mutation -->
                    <excludedClasses>
                        <param>com.fincore.FinCoreApplication</param>
                        <param>com.fincore.controller.*</param>
                        <param>com.fincore.dto.*</param>
                    </excludedClasses>

                    <outputFormats>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>

                    <!-- Ignore Logging/Printing to avoid False Positives -->
                    <avoidCallsTo>
                        <avoidCallsTo>java.util.logging</avoidCallsTo>
                        <avoidCallsTo>org.apache.log4j</avoidCallsTo>
                        <avoidCallsTo>org.slf4j</avoidCallsTo>
                        <avoidCallsTo>org.apache.commons.logging</avoidCallsTo>
                        <avoidCallsTo>java.io.PrintStream</avoidCallsTo>
                    </avoidCallsTo>
                    
                    <mutationThreshold>70</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>