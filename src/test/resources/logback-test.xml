<configuration>
    <!-- 1. Console Appender (So you can still see logs in terminal) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. File Appender (The Critical Part for your Test) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/security-events.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- 4. Specific Logger for your Controller -->
    <logger name="com.fincore.controller" level="WARN" />
</configuration>